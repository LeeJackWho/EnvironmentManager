# 🌐 环境管理系统 - 环境变量配置模板
# 复制此文件为 .env.local 并填入你的实际配置

# ===== Notion API 配置 =====
# 必需：Notion 集成 API 密钥（以 ntn_ 开头）
# 获取方式：https://www.notion.so/my-integrations
NOTION_API_KEY=ntn_your_notion_integration_token_here

# 必需：Notion 数据库 ID（32位字符串）
# 获取方式：从数据库 URL 中复制
NOTION_DATABASE_ID=your_32_character_database_id_here

# ===== 应用配置 =====
# 应用运行环境
NODE_ENV=development

# 应用基础 URL（部署时需要修改）
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ===== 验证码识别服务配置（可选）=====
# 第三方验证码识别服务 API 密钥
CAPTCHA_API_KEY=your_captcha_service_api_key_here

# ===== AI 智能验证码识别配置（推荐）=====
# 统一的 AI 配置 - 支持多种服务商，只需配置这三个参数

# AI API 密钥（支持 OpenAI、OpenRouter 等）
# OpenAI: sk-your_openai_key_here
# OpenRouter: sk-or-v1-your_openrouter_key_here
OPENAI_API_KEY=sk-your_api_key_here

# API 基础 URL（可选）
# OpenAI 官方：留空（使用默认）
# OpenRouter：https://openrouter.ai/api/v1
# 其他服务：填写相应的 API 地址
OPENAI_BASE_URL=

# 模型名称（根据服务商选择）
# OpenAI: gpt-4-vision-preview
# OpenRouter 免费: qwen/qwen2.5-vl-72b-instruct:free
# 其他: 任何兼容 OpenAI Vision API 的模型
MIDSCENE_MODEL_NAME=gpt-4-vision-preview

# ===== 浏览器自动化配置 =====
# 浏览器运行模式（可选）
BROWSER_MODE=headless

# 浏览器超时时间（毫秒）
BROWSER_TIMEOUT=30000

# ===== 性能配置 =====
# 并发任务数量限制
MAX_CONCURRENT_TASKS=5

# 单个网站并发限制
MAX_SITE_CONCURRENT_TASKS=2

# ===== 开发调试配置 =====
# 是否启用调试模式
DEBUG_MODE=false

# 是否保存调试截图
SAVE_DEBUG_SCREENSHOTS=true
