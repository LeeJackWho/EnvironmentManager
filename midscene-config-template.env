# 🤖 Midscene.js 配置模板
# 请根据您使用的服务类型选择相应的配置

# ==========================================
# 选项 1: OpenAI GPT-4 Vision (推荐)
# ==========================================
# 如果您有 OpenAI API 密钥，推荐使用这个配置
# MIDSCENE_API_KEY=sk-your-openai-api-key-here
# MIDSCENE_API_BASE=https://api.openai.com/v1/chat/completions
# MIDSCENE_MODEL_NAME=gpt-4-vision-preview

# ==========================================
# 选项 2: Google Gemini Vision
# ==========================================
# 如果您有 Google API 密钥，可以使用这个配置
# MIDSCENE_API_KEY=<YOUR_GOOGLE_API_KEY>
# MIDSCENE_API_BASE=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro-vision:generateContent
# MIDSCENE_MODEL_NAME=gemini-pro-vision

# ==========================================
# 选项 3: Midscene 官方服务 (如果可用)
# ==========================================
# 如果 Midscene 提供官方 API 服务
# MIDSCENE_API_KEY=your-midscene-api-key-here
# MIDSCENE_API_BASE=https://api.midscenejs.com/v1/analyze
# MIDSCENE_MODEL_NAME=midscene-vision-v1

# ==========================================
# 选项 4: 本地或自定义服务
# ==========================================
# 如果您运行本地 Midscene 服务或使用自定义服务
# MIDSCENE_API_KEY=local-api-key
# MIDSCENE_API_BASE=http://localhost:8080/api/analyze
# MIDSCENE_MODEL_NAME=local-vision-model

# ==========================================
# 当前推荐配置 (基于您的现有设置)
# ==========================================
# 基于您当前的 Google API 密钥，建议使用 Google Gemini Vision
MIDSCENE_API_KEY=<YOUR_GOOGLE_API_KEY>
MIDSCENE_API_BASE=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro-vision:generateContent
MIDSCENE_MODEL_NAME=gemini-pro-vision

# ==========================================
# 可选配置
# ==========================================
# 验证码识别服务 API 密钥（可选）
CAPTCHA_API_KEY=your_captcha_api_key_here

# 请求超时设置（毫秒）
MIDSCENE_TIMEOUT=30000

# 最大重试次数
MIDSCENE_MAX_RETRIES=3

# 调试模式（development 环境自动启用）
MIDSCENE_DEBUG=true
