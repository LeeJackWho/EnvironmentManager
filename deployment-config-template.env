# 🚀 环境管理器部署配置模板
# 复制此文件为 .env.local 并填写您的配置

# ==========================================
# 🔧 基础配置（必需）
# ==========================================

# Notion 集成配置
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here

# ==========================================
# 🤖 AI 智能验证码识别配置（推荐）
# ==========================================

# 统一的 AI 配置 - 支持多种服务商
# 只需配置这三个参数即可适配不同的 AI 服务

# AI API Key (必需)
# OPENAI_API_KEY=your-api-key-here

# API 基础 URL (可选，不同服务商使用不同地址)
# OPENAI_BASE_URL=your-api-base-url

# 模型名称 (根据服务商和需求选择)
# MIDSCENE_MODEL_NAME=your-model-name

# ==========================================
# 🎯 常用配置示例
# ==========================================

# 示例 1: OpenRouter (推荐 - 免费且强大)
# OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MIDSCENE_MODEL_NAME=qwen/qwen2.5-vl-72b-instruct:free

# 示例 2: OpenAI 官方 (付费但精度高)
# OPENAI_API_KEY=sk-your-openai-key-here
# (OPENAI_BASE_URL 留空使用默认)
# MIDSCENE_MODEL_NAME=gpt-4-vision-preview

# 示例 3: 其他兼容服务
# OPENAI_API_KEY=your-custom-api-key
# OPENAI_BASE_URL=https://your-custom-api.com/v1
# MIDSCENE_MODEL_NAME=your-custom-model

# ==========================================
# ⚙️ 可选配置
# ==========================================

# 启用智能验证码识别 (true/false)
MIDSCENE_ENABLED=true

# AI 识别置信度阈值 (0.0-1.0)
MIDSCENE_CONFIDENCE_THRESHOLD=0.7

# API 请求超时时间 (秒)
MIDSCENE_TIMEOUT=30

# 传统验证码识别 API Key (可选)
# CAPTCHA_API_KEY=your_captcha_api_key_here

# ==========================================
# 🌐 部署环境配置
# ==========================================

# 生产环境设置
NODE_ENV=production

# 应用端口 (默认 3000)
# PORT=3000

# 应用域名 (用于 CORS 等)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ==========================================
# 📋 快速配置指南
# ==========================================

# 1. 必需配置 (最少配置)
#    - NOTION_API_KEY: Notion 集成密钥
#    - NOTION_DATABASE_ID: Notion 数据库 ID

# 2. 推荐配置 (智能功能)
#    选择以下任一选项:
#
#    🆓 免费方案: OpenRouter + Qwen2.5-VL
#    OPENAI_API_KEY=sk-or-v1-...
#    OPENAI_BASE_URL=https://openrouter.ai/api/v1
#    MIDSCENE_MODEL_NAME=qwen/qwen2.5-vl-72b-instruct:free
#
#    💰 付费方案: OpenAI GPT-4 Vision
#    OPENAI_API_KEY=sk-...
#    (OPENAI_BASE_URL 留空)
#    MIDSCENE_MODEL_NAME=gpt-4-vision-preview
#
#    🔧 自定义方案: 其他兼容服务
#    OPENAI_API_KEY=your-key
#    OPENAI_BASE_URL=your-api-url
#    MIDSCENE_MODEL_NAME=your-model

# 3. 部署步骤
#    1. 复制此文件为 .env.local
#    2. 填写上述配置
#    3. 运行: npm run build
#    4. 运行: npm start

# ==========================================
# 🔗 获取 API Key 链接
# ==========================================

# Notion API Key:
# https://www.notion.so/my-integrations

# OpenRouter API Key (推荐):
# https://openrouter.ai/

# OpenAI API Key:
# https://platform.openai.com/api-keys

# Google API Key:
# https://console.cloud.google.com/apis/credentials

# ==========================================
# 💡 配置建议
# ==========================================

# 🎯 个人使用: OpenRouter + Qwen2.5-VL (免费)
# 🏢 企业使用: OpenAI GPT-4 Vision (付费但精度高)
# 🧪 测试环境: Google Gemini (免费额度)

# ==========================================
# 🛠️ 故障排除
# ==========================================

# 如果遇到问题:
# 1. 检查 API Key 格式是否正确
# 2. 确认 API Key 有效且有余额/配额
# 3. 检查网络连接到相应的 API 服务
# 4. 查看应用日志获取详细错误信息

# 测试配置:
# 访问 http://localhost:3000/test-captcha-debug.html
# 启用 "使用 Midscene.js 智能识别" 进行测试
