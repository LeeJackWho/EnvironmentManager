{
  "name": "environment-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "npm run lint && npm run type-check",
    "clean": "rm -rf .next out",
    "deploy": "npm run build && npm run start",
    "docker:build": "docker build -t environment-manager .",
    "docker:run": "docker run -p 3000:3000 environment-manager",
    "docker:compose": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "cp .env.example .env.local && npm install && npx playwright install chromium",
    "health": "curl -f http://localhost:3000/api/health || exit 1",
    "clean:all": "npm run clean && rm -rf node_modules package-lock.json",
    "reinstall": "npm run clean:all && npm install",
    "check": "npm run lint && npm run type-check && npm run health",
    "maintenance": "echo '🧹 执行维护任务...' && npm run clean && npm run build"
  },
  "dependencies": {
    "@notionhq/client": "^4.0.1",
    "axios": "^1.10.0",
    "dotenv": "^16.6.1",
    "next": "15.4.1",
    "node-fetch": "^3.3.2",
    "playwright-core": "^1.54.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
